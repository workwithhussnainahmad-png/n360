{
    admin localhost:2019
    auto_https off
}

# Local benchmarking only: HTTP for every Host value on the published port.
http://:3000 {
    encode zstd gzip
    reverse_proxy app:3000 app2:3000 {
        # Route around a busy replica rather than pinning users to its queue.
        lb_policy least_conn
        # Recover brief all-probe failures instead of immediately returning 503.
        # Only GET requests may be replayed after reaching an upstream.
        lb_try_duration 1s
        lb_try_interval 50ms
        lb_retry_match {
            method GET
        }
        # Retire idle sockets before Next's 65s timeout and reuse burst capacity.
        transport http {
            keepalive 60s
            keepalive_idle_conns 1024
            keepalive_idle_conns_per_host 512
        }
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        health_uri /api/ready
        health_interval 10s
        # A queued probe must not remove capacity from an already busy replica.
        # This is an availability timeout; k6 latency thresholds stay unchanged.
        health_timeout 10s
        health_fails 2
        health_passes 1
        fail_duration 30s
        max_fails 1
        # Application errors are not transport failures: a busy request pool
        # must not eject both otherwise live replicas for thirty seconds.
    }
}
